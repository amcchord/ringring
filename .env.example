# Copy to .env for local Docker Compose development. Never commit real values.
APP_ENV=development
APP_BASE_URL=http://localhost:8080
HTTP_ADDR=:8080
DATABASE_PATH=/data/ringring.db

# Generate with: openssl rand -base64 32
RINGRING_MASTER_KEY=
SESSION_SECRET=
ASTERISK_AMI_SECRET=

# Required to open native host signup in production. Share it with trusted hosts.
HOST_SIGNUP_CODE=

# Optional Google OAuth login. Native username/password login works without it.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional: organization admin key used only to provision party projects/keys.
OPENAI_ADMIN_KEY=
OPENAI_ORGANIZATION_ID=
OPENAI_PARTY_SPEND_LIMIT_CENTS=1000

# Deployment
RINGRING_DOMAIN=localhost
SIP_PUBLIC_HOST=localhost
ASTERISK_CONFIG_DIR=
ASTERISK_AMI_ADDR=asterisk:5038
ASTERISK_AMI_USER=ringring
FASTAGI_ADDR=:4573
VOICE_AUDIO_DIR=/asterisk/audio
VOICE_PLAYBACK_DIR=/var/lib/ringring/asterisk/audio
DEV_AUTH=false
TZ=America/New_York
